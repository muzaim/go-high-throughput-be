{
  "info": {
    "_postman_id": "a9b8c7d6-e5f4-4a3b-8c2d-1e2f3a4b5c6d",
    "name": "Flash Sale Inventory Reservation API",
    "description": "Postman collection for High-Concurrency Flash Sale Inventory Reservation Microservice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Reserve Stock",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.reservation_id) {",
              "        pm.environment.set(\"reservation_id\", jsonData.reservation_id);",
              "        pm.collectionVariables.set(\"reservation_id\", jsonData.reservation_id);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"usr_9981\",\n  \"item_id\": \"{{item_id}}\",\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/inventory/reserve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "inventory",
            "reserve"
          ]
        },
        "description": "Atomically reserve inventory in PostgreSQL for a user if sufficient available stock exists."
      },
      "response": []
    },
    {
      "name": "2. Confirm Reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reservation_id\": \"{{reservation_id}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/inventory/confirm",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "inventory",
            "confirm"
          ]
        },
        "description": "Permanently commits an active reservation in PostgreSQL, completing the order process and decrementing physical inventory."
      },
      "response": []
    },
    {
      "name": "3. Check Inventory Stock",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/inventory/stock?item_id={{item_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "inventory",
            "stock"
          ],
          "query": [
            {
              "key": "item_id",
              "value": "{{item_id}}"
            }
          ]
        },
        "description": "Returns current total_stock, reserved_stock, and available_stock for an item."
      },
      "response": []
    },
    {
      "name": "4. Reserve Stock - Insufficient Stock Error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"usr_greedy\",\n  \"item_id\": \"{{item_id}}\",\n  \"quantity\": 999999\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/inventory/reserve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "inventory",
            "reserve"
          ]
        },
        "description": "Test request to verify HTTP 409 INSUFFICIENT_STOCK response when requesting more stock than available."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "item_id",
      "value": "item_4021",
      "type": "string"
    },
    {
      "key": "reservation_id",
      "value": "res_883291-a1b2-c3d4",
      "type": "string"
    }
  ]
}
